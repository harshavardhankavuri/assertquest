DATABASE_URL=postgresql://assertquest:assertquest@localhost:5432/assertquest
PORT=4000
NODE_ENV=development

# JWT
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Google OAuth (optional, off by default — see FR-603)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Flakiness injection (optional, off by default — see FR-1403)
FLAKE_LATENCY_MS=0
FLAKE_FAILURE_RATE=0

# AssertQuest platform layer (docs/api/th-platform.md) — separate account system
# and JWT secret from SwiftCargo's own auth above
THP_ACCESS_TOKEN_SECRET=dev-th-platform-secret-change-me
THP_ACCESS_TOKEN_TTL_SECONDS=604800

# Background jobs (FR-1203 notifications, FR-1303 reporting)
TRACKING_SIMULATION_ENABLED=true
TRACKING_TICK_MS=4000
NOTIFICATION_QUEUE_DELAY_MS=500

# Feature flags (FR-1104)
FEATURE_PRIORITY_LANE=false
FEATURE_EXTENDED_TRACKING=false
FEATURE_NEW_ADMIN_UI=false
