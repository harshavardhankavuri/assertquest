# Copy to .env on the server (docker compose reads .env automatically) and
# fill in real values. Never commit the real .env file.

# Your domain, pointed at the server's IP via DNS A records before starting Caddy
# (e.g. app.example.com and learn.example.com).
APP_DOMAIN=app.example.com
LEARN_DOMAIN=learn.example.com

# Caddy uses this to request Let's Encrypt certificates and for renewal notices.
ACME_EMAIL=you@example.com

# Generate real random secrets, e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
ACCESS_TOKEN_SECRET=change-me
THP_ACCESS_TOKEN_SECRET=change-me
